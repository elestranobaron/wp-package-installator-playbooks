{
  "version": "1.0.0",
  "packages": [
    {
      "name": "Freqtrade",
      "description": "Free and open-source crypto trading bot written in Python. It is designed to support all major exchanges and be controlled via Telegram or a WebUI.",
      "version": "1.0.0",
      "category": "Trading",
      "icon": "dashicons-chart-line",
      "options": [
        {
          "id": "freqtrade_dir",
          "type": "text",
          "label": "Installation Directory",
          "default": "/opt/freqtrade",
          "description": "Absolute path where Freqtrade data and configuration will be stored."
        },
        {
          "id": "freqtrade_port",
          "type": "number",
          "label": "WebUI Port",
          "default": 8080,
          "description": "The port used to access the Freqtrade internal web interface."
        },
        {
          "id": "freqtrade_dry_run",
          "type": "boolean",
          "label": "Enable Dry-Run (Sandbox)",
          "default": true,
          "description": "Keep this enabled to trade with simulated money safely. Disable for live trading."
        }
      ]
    },
    {
      "name": "WordPress (Natif Multi-Distro)",
      "description": "Installation complète de WordPress avec Apache (backend), Nginx (proxy inverse), MariaDB, Fail2Ban et Certbot SSL automatique.",
      "options": [
        {
          "name": "wp_db_name",
          "type": "text",
          "default": "wordpress",
          "label": "Nom de la base de données MySQL"
        },
        {
          "name": "wp_db_user",
          "type": "text",
          "default": "wordpress",
          "label": "Utilisateur MySQL"
        },
        {
          "name": "wp_db_password",
          "type": "password",
          "label": "Mot de passe Root & User MySQL (Sera aussi utilisé pour sécuriser l'installation)"
        },
        {
          "name": "apache_port",
          "type": "number",
          "default": 8080,
          "label": "Port d'écoute interne Apache (HTTP)"
        },
        {
          "name": "apache_ssl_port",
          "type": "number",
          "default": 8081,
          "label": "Port d'écoute interne Apache (HTTPS)"
        },
        {
          "name": "wordpress_install_dir",
          "type": "text",
          "default": "/var/www/html/wordpress",
          "label": "Répertoire d'installation de WordPress (RedHat/Arch)"
        }
      ]
    },
    {
      "id": "t4c-server-linux",
      "name": "T4C Server Linux 1.72",
      "category": "Games",
      "description": "Clone la dernière release de t4c-server-linux, injecte les assets Vircom MEGA dans docker/runtime/, puis lance docker compose (Dockerfile du repo + MariaDB). Fonctionne sur toute distro Linux avec Docker.",
      "playbook": "playbooks/t4c-server-linux/main.yml",
      "icon": "🎮",
      "author": "Thomas Lloancy",
      "version": "1.1.0",
      "requires": [
        "docker",
        "docker-compose-plugin"
      ],
      "options": [
        {
          "key": "deploy_dir",
          "label": "Répertoire d'installation",
          "type": "text",
          "default": "/opt/t4c-server",
          "required": true
        },
        {
          "key": "github_repo",
          "label": "Dépôt GitHub (owner/repo)",
          "type": "text",
          "default": "elestranobaron/t4c-server-linux"
        },
        {
          "key": "release_tag",
          "label": "Tag release (vide = dernière release GitHub)",
          "type": "text",
          "default": ""
        },
        {
          "key": "t4c_assets_dir",
          "label": "Chemin local vers serveur/runtime (sync MEGA Desktop)",
          "type": "text",
          "default": "/opt/t4c-assets/serveur/runtime",
          "description": "Miroir de macgyver/serveur/runtime (WDA, elng, T4CServer.ini)."
        },
        {
          "key": "mega_server_url",
          "label": "Lien MEGA serveur (fallback si pas de sync locale)",
          "type": "text",
          "default": "https://mega.nz/folder/92YQmLIL#3I9KTlXVp7jmqwu2_2bX_Q"
        },
        {
          "key": "t4c_udp_port",
          "label": "Port UDP jeu (hôte → conteneur)",
          "type": "number",
          "default": 11677
        },
        {
          "key": "db_name",
          "label": "Base t4c_server",
          "type": "text",
          "default": "t4c_server"
        },
        {
          "key": "db_user",
          "label": "Utilisateur MariaDB T4C",
          "type": "text",
          "default": "t4cuser"
        },
        {
          "key": "db_password",
          "label": "Mot de passe MariaDB T4C",
          "type": "password",
          "default": "",
          "required": true
        },
        {
          "key": "db_root_password",
          "label": "Mot de passe root MariaDB (conteneur)",
          "type": "password",
          "default": "",
          "required": true
        },
        {
          "key": "t4c_verify_wda_md5",
          "label": "Vérifier MD5 des WDA LP64 au démarrage",
          "type": "boolean",
          "default": true
        },
        {
          "key": "enable_systemd",
          "label": "Service systemd docker compose au boot",
          "type": "boolean",
          "default": true
        }
      ]
    },
    {
      "name": "osTicket (Docker)",
      "description": "Déploiement du célèbre gestionnaire de tickets osTicket via Docker-Compose, adossé à une base MySQL.",
      "options": [
        {
          "name": "osticket_port",
          "type": "number",
          "default": 8080,
          "label": "Port public pour accéder à l'interface osTicket"
        },
        {
          "name": "mysql_root_password",
          "type": "password",
          "label": "Mot de passe Root MySQL"
        },
        {
          "name": "osticket_db_password",
          "type": "password",
          "label": "Mot de passe de la base osTicket"
        }
      ]
    },
    {
      "name": "Forgejo (Docker)",
      "description": "Instance Git Forgejo auto-hébergée légère et souveraine, alternative libre à GitHub.",
      "options": [
        {
          "name": "forgejo_web_port",
          "type": "number",
          "default": 3000,
          "label": "Port d'accès Web HTTP"
        },
        {
          "name": "forgejo_ssh_port",
          "type": "number",
          "default": 2222,
          "label": "Port d'écoute pour les interactions SSH Git"
        }
      ]
    },
    {
      "id": "redis",
      "name": "Redis Standalone",
      "category": "Database",
      "description": "Instance Redis simple pour le cache ou les files d'attente.",
      "playbook": "playbooks/redis/main.yml",
      "options": [
        {
          "key": "redis_port",
          "label": "Port",
          "type": "number",
          "default": 6379
        }
      ]
    },
    {
      "id": "mariadb",
      "name": "MariaDB Server",
      "category": "Database",
      "description": "Base de données SQL relationnelle.",
      "playbook": "playbooks/mariadb/main.yml",
      "options": [
        {
          "key": "db_root_password",
          "label": "Mot de passe Root",
          "type": "password",
          "default": "secret"
        },
        {
          "key": "db_port",
          "label": "Port",
          "type": "number",
          "default": 3306
        }
      ]
    },
    {
      "id": "dummy-check",
      "name": "Dummy Healthcheck",
      "version": "1.0.0",
      "author": "Automation",
      "category": "Maintenance",
      "description": "Playbook de test ultra-léger pour vérifier la liaison Ansible.",
      "playbook": "playbooks/dummy-test/main.yml",
      "options": []
    },
    {
      "id": "radio42-server",
      "name": "Radio 42 Server",
      "category": "Media",
      "description": "Déploie un serveur de diffusion radio complet via Docker : MPD (lecteur), Icecast2 (streaming), Liquidsoap (mixage/live) et une API REST de contrôle pour le plugin WordPress Radio Control Center. Zéro pollution de l'hôte.",
      "playbook": "playbooks/radio42-server/main.yml",
      "icon": "📻",
      "author": "Thomas Lloancy",
      "version": "1.0.0",
      "requires": [
        "docker",
        "docker-compose-plugin"
      ],
      "options": [
        {
          "key": "stream_name",
          "label": "Nom de la radio",
          "type": "text",
          "default": "Ma Radio 42",
          "required": true
        },
        {
          "key": "stream_description",
          "label": "Description du flux",
          "type": "text",
          "default": "Powered by Radio 42"
        },
        {
          "key": "icecast_port",
          "label": "Port public Icecast",
          "type": "number",
          "default": 8000
        },
        {
          "key": "api_port",
          "label": "Port API de contrôle",
          "type": "number",
          "default": 5000
        },
        {
          "key": "live_harbor_port",
          "label": "Port live micro (Harbor Liquidsoap)",
          "type": "number",
          "default": 8005
        },
        {
          "key": "icecast_source_password",
          "label": "Mot de passe source Icecast",
          "type": "password",
          "default": "",
          "required": true
        },
        {
          "key": "icecast_admin_password",
          "label": "Mot de passe admin Icecast",
          "type": "password",
          "default": "",
          "required": true
        },
        {
          "key": "api_secret_key",
          "label": "Clé secrète API (token WordPress)",
          "type": "password",
          "default": "",
          "required": true
        },
        {
          "key": "music_dir",
          "label": "Dossier musique sur l'hôte",
          "type": "text",
          "default": "/opt/radio42/music"
        },
        {
          "key": "deploy_dir",
          "label": "Dossier de déploiement",
          "type": "text",
          "default": "/opt/radio42"
        }
      ]
    },
    {
      "id": "redis-cluster",
      "name": "Redis Cluster",
      "category": "Database",
      "description": "Cluster Redis haute disponibilité (3 maîtres, 3 esclaves).",
      "playbook": "playbooks/redis-cluster/main.yml",
      "options": [
        {
          "key": "start_port",
          "label": "Port de départ",
          "type": "number",
          "default": 7000
        }
      ]
    }
  ]
}
